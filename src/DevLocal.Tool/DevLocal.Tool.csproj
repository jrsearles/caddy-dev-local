<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>devlocal</ToolCommandName>
    <PackageId>DevLocal.Tool</PackageId>
    <Version>0.1.0-preview.9</Version>
    <Description>Windows Docker discovery and Caddy integration tool for local development</Description>
    <PackageReadmeFile>csharp-port.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DevLocal.Core/DevLocal.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="go-text-template" Version="1.0.70" />
    <None Include="../../docs/csharp-port.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../generator/index.html.tmpl" LogicalName="DevLocal.IndexTemplate" />
    <EmbeddedResource Include="../../generator/index.css" LogicalName="DevLocal.IndexCss" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DevLocal.Tool.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
