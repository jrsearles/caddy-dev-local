<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <ToolCommandName>devlocal</ToolCommandName>
    <PackageId>DevLocal.Tool</PackageId>
    <Description>Windows Docker discovery and Caddy integration tool for local development</Description>
    <PackageReadmeFile>csharp-port.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DevLocal.Core/DevLocal.Core.csproj" />
    <ProjectReference Include="../DevLocal.Ui/DevLocal.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <None Include="../../docs/csharp-port.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DevLocal.Tool.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
