@inherits LayoutComponentBase
@implements IDisposable
@inject UiState State
@inject TldProvider Tld

<PageTitle>devlocal — Container Index</PageTitle>

<h1 class="visually-hidden">devlocal container index</h1>
<AppHeader Model="@dashboard" />
<ErrorBanner Model="@dashboard" />
<TabNav Model="@dashboard" />

<main class="content">
    <CascadingValue Value="@dashboard">
        @Body
    </CascadingValue>
</main>

@code {
    private DashboardModel dashboard = DashboardBuilder.Empty;

    protected override void OnInitialized()
    {
        dashboard = Build();
        State.Changed += OnStateChanged;
    }

    private DashboardModel Build() => DashboardBuilder.Build(Tld.Value, State.Current);

    private void OnStateChanged() => InvokeAsync(() =>
    {
        dashboard = Build();
        StateHasChanged();
    });

    public void Dispose() => State.Changed -= OnStateChanged;
}
