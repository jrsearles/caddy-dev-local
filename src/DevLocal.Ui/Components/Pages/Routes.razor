@page "/routes"

<PageTitle>devlocal — Registered Routes</PageTitle>

<div class="section-label"><span>Registered Routes</span></div>
@if (Model.Routes.Count == 0)
{
    <div class="route-empty">No routes found.</div>
}
else
{
    <div class="route-table-wrap">
        <QuickGrid Items="Model.Routes.AsQueryable()" Class="route-grid" Theme="devlocal">
            <TemplateColumn Title="Handler" SortBy="GridSort<RouteModel>.ByAscending(route => route.Handlers.FirstOrDefault() ?? string.Empty)">
                @foreach (var handler in context.Handlers)
                {
                    <span class="route-handler-badge @HandlerClass(handler)">@handler</span>
                }
                @if (context.Id.Length > 0)
                {
                    <div class="route-id-val">@@@context.Id</div>
                }
            </TemplateColumn>
            <TemplateColumn Title="Host" SortBy="GridSort<RouteModel>.ByAscending(route => route.Hosts.FirstOrDefault() ?? string.Empty)">
                @foreach (var host in context.Hosts)
                {
                    <div class="route-host-val"><a href="@($"https://{host}")" target="_blank" rel="noopener">@host</a></div>
                }
                @foreach (var path in context.Paths)
                {
                    <div class="route-host-val route-host-path">↳ @path</div>
                }
            </TemplateColumn>
            <TemplateColumn Title="Upstream" SortBy="GridSort<RouteModel>.ByAscending(route => route.Upstreams.FirstOrDefault() ?? route.FileRoot)">
                @if (context.Upstreams.Count > 0)
                {
                    <span class="route-upstream-val">@string.Join(", ", context.Upstreams)</span>
                }
                else if (context.FileRoot.Length > 0)
                {
                    <span class="route-upstream-val">@context.FileRoot</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="TLS" SortBy="GridSort<RouteModel>.ByAscending(route => route.Tls)">
                @if (context.Tls.Length > 0)
                {
                    <span class="route-tls-badge @context.TlsClass">@context.Tls</span>
                }
            </TemplateColumn>
            <TemplateColumn Title="" Class="route-action-cell">
                @if (context.Id != "devlocal-index" && context.Hosts.Count > 0 && Model.HasDomain(context.Hosts[0]))
                {
                    <a class="route-link" href="@($"/?q={Uri.EscapeDataString(context.Hosts[0])}")"
                       title="Go to container" aria-label="Go to container">
                        <SvgIcon Name="external" />
                    </a>
                }
            </TemplateColumn>
        </QuickGrid>
    </div>
}

@code {
    [CascadingParameter] private DashboardModel Model { get; set; } = DashboardBuilder.Empty;

    private static string HandlerClass(string handler) => handler switch
    {
        "reverse_proxy" => "handler-reverse_proxy",
        "file_server" => "handler-file_server",
        _ => "handler-other",
    };
}
