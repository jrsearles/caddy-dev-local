@page "/config"

<PageTitle>devlocal — Caddy Config</PageTitle>

<div class="config-view">
    <div class="config-toolbar">
        <span class="section-label">Config</span>
        <div class="config-toolbar-actions">
            <button class="config-action-btn" type="button" @onclick="ToggleRaw">@(raw ? "Tree View" : "Raw JSON")</button>
            @if (raw)
            {
                <button class="config-action-btn" type="button" @onclick="ToggleCompact">@(compact ? "Prettify" : "Compact")</button>
            }
            else
            {
                <button class="config-action-btn" type="button" @onclick="ExpandAll">Expand all</button>
                <button class="config-action-btn" type="button" @onclick="CollapseAll">Collapse all</button>
            }
        </div>
    </div>
    @if (Node is null)
    {
        <div class="route-empty">No Caddy configuration available.</div>
    }
    else if (raw)
    {
        <pre class="config-pre">@Text</pre>
    }
    else
    {
        <div class="json-container config-pre">
            <JsonTreeNode Tree="Tree" Node="Node" Path="" Key="config" />
        </div>
    }
</div>

@code {
    private const int InitialDepth = 3;

    private readonly JsonTreeState Tree = new();
    private string renderedJson = "";
    private string text = "";
    private JsonNode? node;
    private bool raw;
    private bool compact;

    private JsonNode? Node => node;

    private string Text => text;

    [CascadingParameter] private DashboardModel Model { get; set; } = DashboardBuilder.Empty;

    protected override void OnParametersSet()
    {
        if (Model.ConfigJson == renderedJson)
            return;
        var replaced = node is null;
        renderedJson = Model.ConfigJson;
        Render();
        if (replaced || node is null)
        {
            Tree.Reset();
            Tree.Open(JsonTreeState.Paths(node, InitialDepth));
        }
    }

    private void Render()
    {
        node = JsonText.Parse(renderedJson);
        text = compact ? JsonText.Compact(renderedJson) : JsonText.Pretty(renderedJson);
    }

    private void ToggleRaw() => raw = !raw;

    private void ToggleCompact()
    {
        compact = !compact;
        Render();
    }

    private void ExpandAll() => Tree.Open(JsonTreeState.Paths(node));

    private void CollapseAll() => Tree.CloseAll();
}
