<Project>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <BaseIntermediateOutputPath>obj-win/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin-win/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/obj-win/**;**/bin/**;**/bin-win/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="All" />
  </ItemGroup>
</Project>
