<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>devlocal — Container Index</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0%25' stop-color='%231f6feb'/%3E%3Cstop offset='100%25' stop-color='%2358a6ff'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='24' height='24' rx='5' fill='url(%23g)'/%3E%3Cpath d='M13 10V3L4 14h7v7l9-11h-7z' fill='white' stroke='white' stroke-width='0.5' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="stylesheet" href="https://unpkg.com/@pgrabovets/json-view@2.8.1/dist/jsonview.css">
    <script src="https://unpkg.com/@pgrabovets/json-view@2.8.1/dist/jsonview.umd.cjs"></script>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('devlocal-theme');
                if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="index.css">
</head>
<body>
    <header class="header">
        <a class="brand" href="/">
            <div class="brand-icon">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <span class="brand-name">devlocal</span>
        </a>

        <div class="header-search">
            <input class="search-input" id="devlocal-search" type="search" placeholder="Filter containers…" autocomplete="off" spellcheck="false">
        </div>

        <div class="header-stats">
            {{if gt .RunningCount 0}}<span class="chip chip-running"><span class="chip-dot"></span>{{.RunningCount}} running</span>{{end}}
            {{if gt .StoppedCount 0}}<span class="chip chip-stopped"><span class="chip-dot"></span>{{.StoppedCount}} stopped</span>{{end}}
            {{if .Groups}}<span class="chip chip-projects"><span class="chip-dot"></span>{{len .Groups}} {{if eq (len .Groups) 1}}project{{else}}projects{{end}}</span>{{end}}
            <span class="chip" title="Refreshes when containers change"><span class="live-dot" id="liveDot"></span>live</span>
            <button class="theme-toggle" id="themeToggle" type="button" onclick="cycleTheme()" aria-label="Switch theme" title="Switch to light theme">
                <svg class="icon icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="icon icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="icon icon-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </button>
        </div>
    </header>

{{if .DiscoveryError}}
    <div class="banner banner-error" id="errorBanner">
        <svg class="banner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="banner-msg">Docker discovery error: {{.DiscoveryError}}</span>
        {{if .LastRefreshUnix}}<span class="banner-time">Last refresh: <time class="timeago" data-ts="{{.LastRefreshUnix}}">…</time></span>{{end}}
        <button class="banner-dismiss" type="button" onclick="document.getElementById('errorBanner').remove()" title="Dismiss">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
{{end}}

    <nav class="tab-nav">
        <button class="tab-btn active" data-tab="containers" onclick="switchTab('containers')">Containers</button>
        {{if .ConfigJSON}}<button class="tab-btn" data-tab="routes" onclick="switchTab('routes')">Routes<span id="route-count-badge" class="tab-count" style="display:none"></span></button>{{end}}
        {{if .ConfigJSON}}<button class="tab-btn" data-tab="config" onclick="switchTab('config')">Caddy</button>{{end}}
    </nav>

{{define "ddIcon"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 7.7c0-.6-.4-1.2-.8-1.5l-6.3-3.9a1.72 1.72 0 0 0-1.7 0l-10.3 6c-.5.2-.9.8-.9 1.4v6.6c0 .5.4 1.2.8 1.5l6.3 3.9a1.72 1.72 0 0 0 1.7 0l10.3-6c.5-.3.9-1 .9-1.5Z"/><path d="M10 21.9V14L2.1 9.1"/><path d="m10 14 11.9-6.9"/><path d="M14 19.8v-8.1"/><path d="M18 17.5V9.4"/></svg>{{end}}

{{define "copyIcon"}}<svg class="icon-copy" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22.6,4H21.55a3.89,3.89,0,0,0-7.31,0H13.4A2.41,2.41,0,0,0,11,6.4V10H25V6.4A2.41,2.41,0,0,0,22.6,4ZM23,8H13V6.25A.25.25,0,0,1,13.25,6h2.69l.12-1.11A1.24,1.24,0,0,1,16.61,4a2,2,0,0,1,3.15,1.18l.09.84h2.9a.25.25,0,0,1,.25.25Z"/><path d="M33.25,18.06H21.33l2.84-2.83a1,1,0,1,0-1.42-1.42L17.5,19.06l5.25,5.25a1,1,0,0,0,.71.29,1,1,0,0,0,.71-1.7l-2.84-2.84H33.25a1,1,0,0,0,0-2Z"/><path d="M29,16h2V6.68A1.66,1.66,0,0,0,29.35,5H27.08V7H29Z"/><path d="M29,31H7V7H9V5H6.64A1.66,1.66,0,0,0,5,6.67V31.32A1.66,1.66,0,0,0,6.65,33H29.36A1.66,1.66,0,0,0,31,31.33V22.06H29Z"/></svg><svg class="icon-check" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>{{end}}

{{define "containerCard"}}
    <div class="card{{if not .IsRunning}} stopped{{end}}"
         data-name="{{.ContainerName}}"
         data-image="{{.Image}}"
         data-project="{{.ComposeProject}}"
         data-service="{{.ComposeService}}"
         data-domains="{{.DomainsFlat}}"
         data-id="{{.ContainerIDShort}}"
         data-ip="{{.IPAddress}}"
         data-networks="{{range $i, $n := .Networks}}{{if $i}},{{end}}{{$n}}{{end}}"
         data-published="{{range $i, $p := .PublishedPortPairs}}{{if $i}},{{end}}{{$p.Private}}:{{$p.Public}}{{end}}"
         data-health="{{.Health}}"
         data-labels='{{.LabelsJSON}}'>
        <div class="card-header" onclick="openDrawer(this.closest('.card'))">
            {{if .Icon}}<img class="container-icon" src="{{.Icon}}" alt="" title="{{.Image}}" onerror="this.style.display='none'">{{end}}
            <div class="card-title">
                <div class="container-name">
                    <span>{{.ContainerName}}</span>
                </div>
                <div class="container-meta">{{.Image}}{{if .IPAddress}} · {{.IPAddress}}{{end}}</div>
            </div>
            <div class="card-badges">
                {{if .ComposeService}}<span class="badge badge-service">{{.ComposeService}}</span>{{end}}
                <div class="status {{if .IsRunning}}status-running{{else}}status-stopped{{end}}">
                    <div class="status-dot"></div>
                    <span class="status-label">{{if .IsRunning}}running{{else}}stopped{{end}}</span>
                    {{if and .IsRunning (and (ne .Health "") (ne .Health "none"))}}<span class="health-badge health-{{.Health}}">{{.Health}}</span>{{end}}
                    <span class="status-time">{{if .IsRunning}}since <time class="timeago" data-ts="{{.StartedUnix}}" title="{{.StartedAbs}}">{{.StartedAbs}}</time>{{else if .StoppedUnix}}<time class="timeago" data-ts="{{.StoppedUnix}}" title="{{.StoppedAbs}}">{{.StoppedAbs}}</time>{{end}}</span>
                </div>
            </div>
        </div>
        {{if .Domains}}<div class="card-domains">
            {{range .Domains}}            <div class="domain-row" onclick="event.stopPropagation()">
                {{if .URL}}<a class="domain-link" href="{{.URL}}" target="_blank" rel="noopener noreferrer">{{.Domain}}</a>{{else}}<span class="domain-plain">{{.Domain}}</span>{{end}}
                {{$url := .URL}}<div class="port-chips">{{range .Chips}}<span class="port-chip">{{if .IsHTTP}}<a class="chip-globe" href="{{$url}}" target="_blank" rel="noopener noreferrer" aria-label="Open {{$url}}" title="Open {{$url}}" onclick="event.stopPropagation()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></a>{{end}}:{{.PortStr}}{{if .CopyText}}<button class="copy-btn chip-copy-btn" type="button" data-copy="{{.CopyText}}" onclick="copyDomain(this)" aria-label="Copy {{.CopyText}}" title="Copy {{.CopyText}}">{{template "copyIcon"}}</button>{{end}}</span>{{end}}</div>
            </div>
{{end}}        </div>{{else if .NoPorts}}<div class="card-domains"><div class="domain-row domain-row-noports"><span class="domain-plain">no ports exposed</span></div></div>{{end}}
    </div>
{{end}}

    <main class="content">
        <div id="tab-containers" class="tab-panel active">
{{if or .DisplayRows .Groups}}
{{if .DisplayRows}}
            <div class="section-label"><span>Containers</span>{{if .StandaloneDockerDesktopURL}}<a class="dd-link" href="{{.StandaloneDockerDesktopURL}}" title="{{.StandaloneDockerLabel}}" aria-label="{{.StandaloneDockerLabel}}">{{template "ddIcon"}}</a>{{end}}</div>
            <div class="card-list" id="top-list">
{{range .DisplayRows}}{{template "containerCard" .}}{{end}}
            </div>
{{end}}
{{if .Groups}}
            <div class="section-label"><span>Compose Projects</span></div>
{{range .Groups}}
            <div class="project-section" data-project="{{.Project}}">
                <div class="project-header">
                    <button class="project-toggle" aria-expanded="false" onclick="toggleProject(this)">
                        <span class="chevron">▸</span>
                        <span class="project-name">{{.Project}}</span>
                        <span class="project-status-chips">
                            {{if gt .RunningCount 0}}<span class="mini-chip mini-chip-running">{{.RunningCount}} running</span>{{end}}
                            {{if gt .StoppedCount 0}}<span class="mini-chip mini-chip-stopped">{{.StoppedCount}} stopped</span>{{end}}
                        </span>
                        <span class="project-count">{{len .Rows}} {{if eq (len .Rows) 1}}service{{else}}services{{end}}</span>
                    </button>
                    {{if .DockerDesktopURL}}<a class="dd-link" href="{{.DockerDesktopURL}}" title="{{.DockerDesktopLabel}}" aria-label="{{.DockerDesktopLabel}}" onclick="event.stopPropagation()">{{template "ddIcon"}}</a>{{end}}
                </div>
                <div class="project-cards">
{{range .Rows}}{{template "containerCard" .}}{{end}}
                </div>
            </div>
{{end}}
{{end}}
            <div class="no-match" id="noMatch">No containers match your filter.</div>
{{else}}
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
                <p>No containers registered.</p>
                <ul class="empty-hints">
                    <li>Docker socket mounted at <code>/var/run/docker.sock</code>?</li>
                    <li>Containers expose or publish ports?</li>
                    <li>Container is on the same Docker network as the proxy?</li>
                    <li>See the <a href="https://github.com/jrsearles/caddy-dev-local#troubleshooting" target="_blank" rel="noopener">README</a> for troubleshooting.</li>
                </ul>
                {{if .DiscoveryError}}<div class="empty-error">{{.DiscoveryError}}</div>{{end}}
            </div>
{{end}}
        </div>
{{if .ConfigJSON}}
        <div id="tab-routes" class="tab-panel">
            <div class="section-label"><span>Registered Routes</span></div>
            <div class="route-table-wrap" id="routeGrid"></div>
            <div class="route-empty" id="routeEmpty" hidden>No routes found.</div>
        </div>
        <div id="tab-config" class="tab-panel">
            <div class="config-view">
                <div class="config-toolbar">
                    <span class="section-label">Config</span>
                    <div class="config-toolbar-actions">
                        <button class="config-action-btn" id="rawToggle" type="button" onclick="toggleRawJSON()">Raw JSON</button>
                        <button class="config-action-btn" id="expandAllBtn" type="button" onclick="configExpandAll()" hidden>Expand all</button>
                        <button class="config-action-btn" id="collapseAllBtn" type="button" onclick="configCollapseAll()" hidden>Collapse all</button>
                    </div>
                </div>
                <pre class="config-pre" id="config-raw">{{.ConfigJSON}}</pre>
                <div class="config-pre" id="config-tree" hidden></div>
            </div>
            <script type="application/json" id="config-json">{{.ConfigJSONRaw}}</script>
        </div>
{{end}}
    </main>

    <!-- ── Drawer ───────────────────────────────────────────────────── -->
    <div class="drawer-backdrop" id="drawerBackdrop" onclick="closeDrawer()"></div>
    <aside class="drawer" id="drawer">
        <div class="drawer-header">
            <div class="drawer-title">
                <div class="drawer-name" id="drawerName"></div>
                <div class="drawer-subtitle" id="drawerSubtitle"></div>
            </div>
            <button class="drawer-close" type="button" onclick="closeDrawer()" title="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="drawer-body" id="drawerBody"></div>
    </aside>

    <script>
    function setProjectOpen(sec, open) {
        const btn = sec.querySelector('.project-toggle');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        const list = sec.querySelector('.project-cards');
        if (list) list.classList.toggle('open', open);
    }

    // ── Copy ─────────────────────────────────────────────────────────
    function copyDomain(btn) {
        const text = btn.getAttribute('data-copy');
        const done = () => {
            btn.classList.add('copied');
            setTimeout(() => btn.classList.remove('copied'), 1200);
        };
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done, () => fallbackCopy(text, done));
        } else {
            fallbackCopy(text, done);
        }
    }
    function fallbackCopy(text, done) {
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta); done();
    }

    // ── Theme ─────────────────────────────────────────────────────────
    const themeLabels = {
        system: 'Switch to light theme',
        light:  'Switch to dark theme',
        dark:   'Switch to system theme',
    };

    function currentTheme() {
        const t = document.documentElement.getAttribute('data-theme');
        return (t === 'light' || t === 'dark') ? t : 'system';
    }

    function updateThemeButton() {
        const btn = document.getElementById('themeToggle');
        if (!btn) return;
        const t = currentTheme();
        btn.title = themeLabels[t];
        btn.setAttribute('aria-label', btn.title);
    }

    function setTheme(t) {
        const root = document.documentElement;
        try {
            if (t === 'system') {
                root.removeAttribute('data-theme');
                localStorage.removeItem('devlocal-theme');
            } else {
                root.setAttribute('data-theme', t);
                localStorage.setItem('devlocal-theme', t);
            }
        } catch (e) {}
        updateThemeButton();
    }

    function cycleTheme() {
        const next = currentTheme() === 'system' ? 'light' : currentTheme() === 'light' ? 'dark' : 'system';
        setTheme(next);
    }

    // ── Tab switching ─────────────────────────────────────────────────
    function switchTab(name) {
        document.querySelectorAll('.tab-btn').forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.tab === name);
        });
        document.querySelectorAll('.tab-panel').forEach(function(panel) {
            panel.classList.toggle('active', panel.id === 'tab-' + name);
        });
        if (name === 'routes') renderRoutes();
        if (name === 'config' && !configTree) renderConfigTree();
        try { sessionStorage.setItem('devlocal-tab', name); } catch (e) {}
        pushState();
    }

    // ── Config JSON tree (expand/collapse + highlighting) ─────────────
    let configTree = null;
    let showingRaw = false;

    function configExpandAll() {
        if (configTree && window.jsonview) jsonview.expand(configTree);
    }
    function configCollapseAll() {
        if (configTree && window.jsonview) jsonview.collapse(configTree);
    }

    function toggleRawJSON() {
        showingRaw = !showingRaw;
        const raw = document.getElementById('config-raw');
        const tree = document.getElementById('config-tree');
        const btn = document.getElementById('rawToggle');
        const expandAllBtn = document.getElementById('expandAllBtn');
        const collapseAllBtn = document.getElementById('collapseAllBtn');
        if (showingRaw) {
            if (raw) raw.style.display = '';
            if (tree) tree.hidden = true;
            if (btn) btn.textContent = 'Tree View';
            if (expandAllBtn) expandAllBtn.hidden = true;
            if (collapseAllBtn) collapseAllBtn.hidden = true;
        } else {
            if (raw) raw.style.display = 'none';
            if (tree) tree.hidden = false;
            if (!configTree) renderConfigTree();
            if (btn) btn.textContent = 'Raw JSON';
            if (expandAllBtn) expandAllBtn.hidden = !configTree;
            if (collapseAllBtn) collapseAllBtn.hidden = !configTree;
        }
    }

    function renderConfigTree() {
        const src = document.getElementById('config-json');
        const tree = document.getElementById('config-tree');
        const raw = document.getElementById('config-raw');
        const expandAllBtn = document.getElementById('expandAllBtn');
        const collapseAllBtn = document.getElementById('collapseAllBtn');
        if (!src || !tree || !raw || typeof jsonview === 'undefined') return;
        try {
            configTree = jsonview.create(JSON.parse(src.textContent));
            jsonview.traverse(configTree, (n) => { if (n.depth <= 1) n.isExpanded = true; });
            jsonview.render(configTree, tree);
            raw.style.display = 'none';
            tree.hidden = false;
            if (expandAllBtn) expandAllBtn.hidden = false;
            if (collapseAllBtn) collapseAllBtn.hidden = false;
        } catch (e) {}
    }

    // ── Project toggle ────────────────────────────────────────────────
    function toggleProject(btn) {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        const sec = btn.closest('.project-section');
        const list = sec ? sec.querySelector('.project-cards') : null;
        if (list) list.classList.toggle('open', !expanded);
        saveUIState();
        pushState();
    }

    // ── UI state across auto-reloads (sessionStorage) ────────────────
    function saveUIState() {
        try {
            const open = [];
            document.querySelectorAll('.project-toggle[aria-expanded="true"]').forEach((btn) => {
                open.push(btn.closest('.project-section').dataset.project);
            });
            sessionStorage.setItem('devlocal-open', JSON.stringify(open));
            const activeTab = document.querySelector('.tab-btn.active');
            if (activeTab) sessionStorage.setItem('devlocal-tab', activeTab.dataset.tab);
            sessionStorage.setItem('devlocal-scroll', String(Math.round(window.scrollY)));
            const q = document.getElementById('devlocal-search');
            if (q) sessionStorage.setItem('devlocal-search', q.value);
        } catch (e) {}
    }
    function restoreUIState() {
        try {
            const params = new URLSearchParams(location.search);

            const tab = params.get('tab') || sessionStorage.getItem('devlocal-tab') || 'containers';
            if (tab !== 'containers') switchTab(tab);

            const open = JSON.parse(sessionStorage.getItem('devlocal-open') || '[]');
            const openParam = params.getAll('open');
            const openSet = new Set([...open, ...openParam]);
            document.querySelectorAll('.project-section').forEach((sec) => {
                if (openSet.has(sec.dataset.project)) setProjectOpen(sec, true);
            });

            const q = params.get('q') || sessionStorage.getItem('devlocal-search') || '';
            if (q) {
                const input = document.getElementById('devlocal-search');
                if (input) { input.value = q; runFilter(q); }
            }

            const scroll = parseInt(sessionStorage.getItem('devlocal-scroll') || '0', 10);
            if (scroll > 0) window.scrollTo(0, scroll);
        } catch (e) {}
    }

    // ── URL state (history.replaceState) ─────────────────────────────
    function pushState() {
        try {
            const params = new URLSearchParams();
            const activeTab = document.querySelector('.tab-btn.active');
            if (activeTab && activeTab.dataset.tab !== 'containers') params.set('tab', activeTab.dataset.tab);
            const q = (document.getElementById('devlocal-search') || {}).value || '';
            if (q) params.set('q', q);
            document.querySelectorAll('.project-toggle[aria-expanded="true"]').forEach((btn) => {
                params.append('open', btn.closest('.project-section').dataset.project);
            });
            const qs = params.toString();
            history.replaceState(null, '', qs ? '?' + qs : location.pathname);
        } catch (e) {}
    }

    // ── Search / filter ───────────────────────────────────────────────
    let filterSaveTimer = null;
    let filterOpenSnapshot = null;
    let filterOpened = new Set();
    function onSearchInput() {
        const q = (document.getElementById('devlocal-search') || {}).value || '';
        runFilter(q);
        clearTimeout(filterSaveTimer);
        filterSaveTimer = setTimeout(() => { saveUIState(); pushState(); }, 150);
    }

    function runFilter(raw) {
        const terms = raw.trim().toLowerCase().split(/\s+/).filter(Boolean);
        const noMatch = document.getElementById('noMatch');
        let anyVisible = false;

        if (!terms.length) {
            if (filterOpenSnapshot) {
                const keepOpen = new Set(filterOpenSnapshot);
                filterOpened.forEach((name) => {
                    if (keepOpen.has(name)) return;
                    document.querySelectorAll('.project-section').forEach((sec) => {
                        if (sec.dataset.project === name) setProjectOpen(sec, false);
                    });
                });
            }
            filterOpenSnapshot = null;
            filterOpened = new Set();
        } else if (!filterOpenSnapshot) {
            filterOpenSnapshot = new Set(
                [...document.querySelectorAll('.project-toggle[aria-expanded="true"]')]
                    .map((btn) => btn.closest('.project-section').dataset.project)
            );
        }

        document.querySelectorAll('.card').forEach((card) => {
            if (!terms.length) {
                card.hidden = false;
                return;
            }
            const haystack = [
                card.dataset.name || '',
                card.dataset.image || '',
                card.dataset.project || '',
                card.dataset.service || '',
                card.dataset.domains || '',
            ].join(' ').toLowerCase();
            card.hidden = !terms.every((t) => haystack.includes(t));
        });

        document.querySelectorAll('.project-section').forEach((sec) => {
            const visible = [...sec.querySelectorAll('.card')].some((c) => !c.hidden);
            sec.hidden = !visible;
            if (visible) {
                anyVisible = true;
                if (terms.length) {
                    setProjectOpen(sec, true);
                    filterOpened.add(sec.dataset.project);
                }
            }
        });

        document.querySelectorAll('#top-list .card').forEach((c) => { if (!c.hidden) anyVisible = true; });

        if (noMatch) noMatch.classList.toggle('visible', !anyVisible && terms.length > 0);
    }

    // ── Relative timestamps ──────────────────────────────────────────
    function timeAgo(ts) {
        const now = Math.floor(Date.now() / 1000);
        const diff = Math.max(0, now - ts);
        if (diff < 10) return 'just now';
        if (diff < 60) return Math.floor(diff) + 's ago';
        const mins = diff / 60;
        if (mins < 60) return Math.floor(mins) + 'm ago';
        const hours = mins / 60;
        if (hours < 24) return Math.floor(hours) + 'h ago';
        const days = hours / 24;
        if (days < 30) return Math.floor(days) + 'd ago';
        const months = days / 30.44;
        if (months < 12) return Math.round(months) + 'mo ago';
        return Math.round(months / 12) + 'y ago';
    }
    function renderTimeAgo() {
        document.querySelectorAll('.timeago').forEach((el) => {
            const ts = parseInt(el.dataset.ts, 10);
            if (!ts) return;
            el.textContent = timeAgo(ts);
        });
    }

    // ── Drawer ────────────────────────────────────────────────────────
    function openDrawer(card) {
        const name    = card.dataset.name    || '';
        const image   = card.dataset.image   || '';
        const id      = card.dataset.id      || '';
        const ip      = card.dataset.ip      || '';
        const health  = card.dataset.health  || '';
        const networks = (card.dataset.networks || '').split(',').filter(Boolean);

        let labels = {};
        try { labels = JSON.parse(card.dataset.labels || '{}'); } catch (e) {}

        const isRunning = !card.classList.contains('stopped');

        document.getElementById('drawerName').textContent = name;
        document.getElementById('drawerSubtitle').textContent = id ? id + ' · ' + (isRunning ? 'running' : 'stopped') : (isRunning ? 'running' : 'stopped');

        const body = document.getElementById('drawerBody');
        const rows = [];

        rows.push(section('Details',
            row('Image', image) +
            (id ? row('ID', id) : '') +
            (ip ? row('IP', ip) : '') +
            (health && health !== 'none' ? row('Health', '<span class="health-badge health-' + esc(health) + '">' + esc(health) + '</span>') : '')
        ));

        if (networks.length) {
            rows.push(section('Networks',
                '<div class="drawer-tags">' + networks.map((n) => '<span class="drawer-tag">' + esc(n) + '</span>').join('') + '</div>'
            ));
        }

        const pubAttr = card.dataset.published || '';
        if (pubAttr) {
            const pairs = pubAttr.split(',').map((p) => p.split(':'));
            if (pairs.length && pairs[0].length === 2) {
                rows.push(section('Published Ports',
                    '<table class="drawer-ports-table"><thead><tr><th>Container</th><th>Host</th></tr></thead><tbody>' +
                    pairs.map(([priv, pub]) => '<tr><td>' + esc(priv) + '</td><td>' + esc(pub) + '</td></tr>').join('') +
                    '</tbody></table>'
                ));
            }
        }

        const labelKeys = Object.keys(labels).sort();
        if (labelKeys.length) {
            rows.push(section('Labels',
                '<div class="drawer-labels">' +
                labelKeys.map((k) => '<div class="drawer-label-row"><span class="drawer-label-key" title="' + esc(k) + '">' + esc(k) + '</span><span class="drawer-label-val" title="' + esc(labels[k]) + '">' + esc(labels[k]) + '</span></div>').join('') +
                '</div>'
            ));
        }

        body.innerHTML = rows.join('');

        document.getElementById('drawer').classList.add('open');
        document.getElementById('drawerBackdrop').classList.add('open');
    }

    function closeDrawer() {
        document.getElementById('drawer').classList.remove('open');
        document.getElementById('drawerBackdrop').classList.remove('open');
    }

    function section(title, content) {
        return '<div><div class="drawer-section-title">' + esc(title) + '</div>' + content + '</div>';
    }

    function row(label, valueHTML) {
        return '<div class="drawer-row"><span class="drawer-row-label">' + esc(label) + '</span><span class="drawer-row-value">' + valueHTML + '</span></div>';
    }

    function esc(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Route table ─────────────────────────────────────────────────
    let routesRendered = false;

    function renderRoutes() {
        if (routesRendered) return;
        const el = document.getElementById('routeGrid');
        const emptyEl = document.getElementById('routeEmpty');
        const countBadge = document.getElementById('route-count-badge');
        if (!el) return;

        const src = document.getElementById('config-json');
        if (!src) { if (emptyEl) emptyEl.hidden = false; return; }

        let config;
        try { config = JSON.parse(src.textContent); } catch (e) { if (emptyEl) emptyEl.hidden = false; return; }

        const servers = (((config.apps || {}).http || {}).servers || {});
        let routes = [];
        Object.keys(servers).forEach(function(serverKey) {
            (servers[serverKey].routes || []).forEach(function(route) { routes.push(route); });
        });

        if (!routes.length) { el.innerHTML = ''; if (emptyEl) emptyEl.hidden = false; return; }
        if (emptyEl) emptyEl.hidden = true;

        const policies = ((config.apps || {}).tls || {}).automation || {};
        const tlsPolicies = policies.policies || [];

        const devlocalDomains = new Map();
        tlsPolicies.forEach(function(pol) {
            if (pol.subjects) {
                pol.subjects.forEach(function(sub) {
                    if (typeof sub === 'string') {
                        devlocalDomains.set(sub, pol.issuers ? pol.issuers[0] : null);
                    } else if (sub && sub.subject) {
                        devlocalDomains.set(sub.subject, pol.issuers ? pol.issuers[0] : null);
                    }
                });
            }
        });

        const containerCards = document.querySelectorAll('#tab-containers .card[data-domains]');
        const domainToCardId = new Map();
        containerCards.forEach(function(card) {
            (card.dataset.domains || '').split(/\s+/).filter(Boolean).forEach(function(d) {
                domainToCardId.set(d, card.dataset.id || '');
            });
        });

        const rows = routes.map(function(route) {
            const id = route['@id'] || '(no id)';
            const hosts = ((route.match || [])[0] || {}).host || [];
            const tlsInfo = hosts.map(function(h) {
                const issuer = devlocalDomains.get(h);
                return { domain: h, issuer: issuer };
            });
            const handlerInfo = extractHandlers(route);
            const hasReverseProxy = handlerInfo.handlers.indexOf('reverse_proxy') !== -1;
            const isIndex = id.indexOf('devlocal-index') !== -1;

            const handlerHtml = handlerInfo.handlers.map(function(h) {
                const cls = h === 'reverse_proxy' ? 'handler-reverse_proxy' : h === 'file_server' ? 'handler-file_server' : 'handler-other';
                return '<span class="route-handler-badge ' + cls + '">' + esc(h) + '</span>';
            }).join(' ');

            let hostHtml = '';
            if (hosts.length) {
                hostHtml = '<div class="route-host-val"><a href="https://' + esc(hosts[0]) + '" target="_blank" rel="noopener">' + esc(hosts[0]) + '</a></div>';
                for (var i = 1; i < hosts.length; i++) {
                    hostHtml += '<div class="route-host-val route-host-secondary"><a href="https://' + esc(hosts[i]) + '" target="_blank" rel="noopener">' + esc(hosts[i]) + '</a></div>';
                }
            }

            const isFileServer = handlerInfo.handlers.indexOf('file_server') !== -1;
            let upstreamHtml = '';
            if (hasReverseProxy && handlerInfo.upstreams.length) {
                upstreamHtml = '<span class="route-upstream-val">' + esc(handlerInfo.upstreams.join(', ')) + '</span>';
            } else if (isFileServer && handlerInfo.root) {
                upstreamHtml = '<span class="route-upstream-val">' + esc(handlerInfo.root) + '</span>';
            }

            let tlsHtml = '';
            if (tlsInfo.length) {
                var t = tlsInfo[0];
                var issuer = t.issuer;
                var label = '', cls = '';
                if (issuer) {
                    if (issuer.module === 'internal' || issuer.module === 'caddy') { label = 'internal CA'; cls = 'tls-internal'; }
                    else { label = issuer.module || 'acme'; cls = 'tls-external'; }
                } else { label = 'none'; cls = 'tls-internal'; }
                tlsHtml = '<span class="route-tls-badge ' + cls + '">' + esc(label) + '</span>';
            }

            let actionHtml = '';
            if (!isIndex && hosts.length) {
                let containerId = '';
                hosts.forEach(function(h) { if (!containerId) containerId = domainToCardId.get(h) || ''; });
                if (containerId) {
                    actionHtml = '<a class="route-link" href="javascript:void(0)" onclick="jumpToContainer(\'' + esc(hosts[0]) + '\'); return false;" title="Go to container">';
                    actionHtml += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>';
                    actionHtml += '</a>';
                }
            }

            return '<tr data-route-id="' + esc(id) + '" data-route-hosts="' + esc(hosts.join(' ')) + '">'
                + '<td>' + handlerHtml + '</td>'
                + '<td>' + hostHtml + '</td>'
                + '<td>' + upstreamHtml + '</td>'
                + '<td>' + tlsHtml + '</td>'
                + '<td class="route-action-cell">' + actionHtml + '</td>'
                + '</tr>';
        }).join('');

        el.innerHTML = '<table class="route-table">'
            + '<thead><tr><th>Handler</th><th>Host</th><th>Upstream</th><th>TLS</th><th></th></tr></thead>'
            + '<tbody>' + rows + '</tbody></table>';
        routesRendered = true;

        if (countBadge) {
            const count = routes.length;
            countBadge.textContent = ' (' + count + ')';
            countBadge.style.display = '';
        }
    }

    function extractHandlers(route) {
        const handlers = [];
        const upstreams = [];
        let root = '';
        const chain = route.handle || [];

        chain.forEach(function(h) {
            if (h.handler === 'subroute' && h.routes) {
                h.routes.forEach(function(r) {
                    (r.handle || []).forEach(function(sh) {
                        if (sh.handler) {
                            handlers.push(sh.handler);
                            if (sh.upstreams) {
                                sh.upstreams.forEach(function(u) { if (u.dial) upstreams.push(u.dial); });
                            }
                            if (sh.root && !root) {
                                root = sh.root;
                            }
                        }
                    });
                });
            } else if (h.handler) {
                handlers.push(h.handler);
                if (h.upstreams) {
                    h.upstreams.forEach(function(u) { if (u.dial) upstreams.push(u.dial); });
                }
                if (h.root && !root) {
                    root = h.root;
                }
            }
        });

        if (!handlers.length) handlers.push('(unknown)');
        return { handlers: handlers, upstreams: upstreams, root: root };
    }

    function jumpToContainer(domain) {
        switchTab('containers');
        setTimeout(function() {
            const cards = document.querySelectorAll('#tab-containers .card[data-domains]');
            cards.forEach(function(card) {
                const domains = (card.dataset.domains || '').split(/\s+/);
                if (domains.indexOf(domain) !== -1) {
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    card.style.transition = 'box-shadow 0.2s';
                    card.style.boxShadow = '0 0 0 2px var(--accent)';
                    setTimeout(function() { card.style.boxShadow = ''; }, 2000);
                }
            });
        }, 50);
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
    });

    // ── Live refresh (version.json poll) ──────────────────────────────
    (() => {
        const dot = document.getElementById('liveDot');
        let prevVersion = null;
        let useFallback = false;
        let fallbackChecks = 0;
        let fallbackPrev = null;

        function hash(str) {
            let h = 5381;
            for (let i = 0; i < str.length; i++) h = ((h << 5) + h + str.charCodeAt(i)) | 0;
            return h;
        }

        function reload() {
            dot.classList.add('ping');
            setTimeout(() => dot.classList.remove('ping'), 500);
            saveUIState();
            setTimeout(() => location.reload(), 400);
        }

        function checkVersion() {
            fetch('/version.json', { cache: 'no-store' })
                .then((r) => { if (!r.ok) throw new Error('not ok'); return r.json(); })
                .then((data) => {
                    fallbackChecks = 0;
                    const v = data.v || '';
                    if (prevVersion !== null && v !== prevVersion) { reload(); return; }
                    prevVersion = v;
                })
                .catch(() => { useFallback = true; prevVersion = null; });
        }

        function checkFallback() {
            fallbackChecks++;
            fetch(location.href, { cache: 'no-store' })
                .then((r) => r.text())
                .then((html) => {
                    const h = hash(html);
                    if (fallbackPrev !== null && h !== fallbackPrev) { reload(); return; }
                    fallbackPrev = h;
                })
                .catch(() => {});
        }

        function check() {
            if (useFallback) {
                checkFallback();
                if (fallbackChecks >= 12) {
                    fallbackChecks = 0;
                    useFallback = false;
                }
            } else {
                checkVersion();
            }
        }

        const searchInput = document.getElementById('devlocal-search');
        if (searchInput) searchInput.addEventListener('input', onSearchInput);

        restoreUIState();
        renderTimeAgo();
        updateThemeButton();
        setInterval(renderTimeAgo, 10000);
        check();
        setInterval(check, 5000);
    })();
    </script>
</body>
</html>
