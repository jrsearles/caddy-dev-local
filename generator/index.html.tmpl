<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>devlocal — Container Index</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
            background: #0d1117;
            color: #c9d1d9;
            padding: 2rem;
        }
        h1 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            color: #58a6ff;
        }
        .subtitle {
            color: #8b949e;
            margin-bottom: 2rem;
            font-size: 0.875rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            text-align: left;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #30363d;
            color: #8b949e;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #21262d;
            vertical-align: top;
        }
        a {
            color: #58a6ff;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
        .status-running {
            color: #3fb950;
        }
        .status-stopped {
            color: #f85149;
        }
        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 1rem;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge-compose {
            background: #1f3a5f;
            color: #58a6ff;
        }
        .badge-standalone {
            background: #2d1f3a;
            color: #bc8cff;
        }
        .empty {
            color: #8b949e;
            padding: 2rem;
            text-align: center;
        }
        .port {
            color: #8b949e;
            font-size: 0.8rem;
        }
        .ip-address {
            color: #8b949e;
            font-size: 0.8rem;
            margin-top: 0.25rem;
        }
        tr.stopped {
            opacity: 0.5;
        }
        .copy-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            margin-left: 0.35rem;
            padding: 0.15rem;
            background: none;
            border: none;
            cursor: pointer;
            color: #8b949e;
            border-radius: 0.25rem;
            line-height: 0;
            position: relative;
        }
        .copy-btn:hover {
            color: #58a6ff;
            background: #21262d;
        }
        .copy-btn .icon-copy,
        .copy-btn .icon-check {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }
        .copy-btn .icon-check {
            display: none;
        }
        .copy-btn.copied {
            color: #3fb950;
        }
        .copy-btn.copied .icon-copy {
            display: none;
        }
        .copy-btn.copied .icon-check {
            display: block;
        }
        .copy-btn::after {
            content: "Copied!";
            position: absolute;
            bottom: 120%;
            left: 50%;
            transform: translateX(-50%) translateY(2px);
            background: #30363d;
            color: #c9d1d9;
            padding: 0.2rem 0.45rem;
            border-radius: 0.3rem;
            font-size: 0.7rem;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s ease;
            z-index: 10;
        }
        .copy-btn.copied::after {
            opacity: 1;
        }
    </style>
</head>
<body>
    <h1>devlocal</h1>
    <p class="subtitle">Local Docker container index</p>
{{if .DisplayRows}}
    <table>
        <thead>
            <tr>
                <th>Domain</th>
                <th>Container</th>
                <th>Image</th>
                <th>Compose</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
{{range .DisplayRows}}
            <tr{{if not .IsRunning}} class="stopped"{{end}}>
                <td>{{if .URL}}<a href="{{.URL}}">{{.Domain}}</a>{{else}}{{.Domain}}{{end}} <span class="port">:{{.PortStr}}</span>{{if .CopyText}}<button class="copy-btn" type="button" data-copy="{{.CopyText}}" onclick="copyDomain(this)" aria-label="Copy {{.CopyText}}" title="Copy {{.CopyText}}">
                    <svg class="icon-copy" viewBox="0 0 36 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22.6,4H21.55a3.89,3.89,0,0,0-7.31,0H13.4A2.41,2.41,0,0,0,11,6.4V10H25V6.4A2.41,2.41,0,0,0,22.6,4ZM23,8H13V6.25A.25.25,0,0,1,13.25,6h2.69l.12-1.11A1.24,1.24,0,0,1,16.61,4a2,2,0,0,1,3.15,1.18l.09.84h2.9a.25.25,0,0,1,.25.25Z"></path><path d="M33.25,18.06H21.33l2.84-2.83a1,1,0,1,0-1.42-1.42L17.5,19.06l5.25,5.25a1,1,0,0,0,.71.29,1,1,0,0,0,.71-1.7l-2.84-2.84H33.25a1,1,0,0,0,0-2Z"></path><path d="M29,16h2V6.68A1.66,1.66,0,0,0,29.35,5H27.08V7H29Z"></path><path d="M29,31H7V7H9V5H6.64A1.66,1.66,0,0,0,5,6.67V31.32A1.66,1.66,0,0,0,6.65,33H29.36A1.66,1.66,0,0,0,31,31.33V22.06H29Z"></path></svg>
                    <svg class="icon-check" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg>
                </button>{{end}}</td>
                {{if .IsFirst}}<td{{if gt .RowSpan 1}} rowspan="{{.RowSpan}}"{{end}}>{{.ContainerName}}{{if .IPAddress}}<div class="ip-address">{{.IPAddress}}</div>{{end}}</td>
                <td{{if gt .RowSpan 1}} rowspan="{{.RowSpan}}"{{end}}>{{.Image}}</td>
                <td{{if gt .RowSpan 1}} rowspan="{{.RowSpan}}"{{end}}>{{if .ComposeProject}}<span class="badge badge-compose">{{.ComposeProject}}/{{.ComposeService}}</span>{{else}}<span class="badge badge-standalone">standalone</span>{{end}}</td>
                <td{{if gt .RowSpan 1}} rowspan="{{.RowSpan}}"{{end}}>{{if .IsRunning}}<span class="status-running">running</span><br>{{.StartedAt}}{{else}}<span class="status-stopped">stopped</span><br>{{.StoppedAt}}{{end}}</td>{{end}}
            </tr>
{{end}}
        </tbody>
    </table>
{{else}}
    <p class="empty">No containers registered.</p>
{{end}}
    <script>
    function copyDomain(btn) {
        var text = btn.getAttribute('data-copy');
        function done() {
            btn.classList.add('copied');
            setTimeout(function () { btn.classList.remove('copied'); }, 1200);
        }
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text, done); });
        } else {
            fallbackCopy(text, done);
        }
    }
    function fallbackCopy(text, done) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        done();
    }
    </script>
</body>
</html>
